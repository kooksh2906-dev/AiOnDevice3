        "reveal": "always"
      }
    },
    {
      "label": "Dashboard: preview",
      "type": "process",
      "command": "npm",
      "windows": {
        "command": "npm.cmd"
      },
      "args": [
        "run",
        "preview"
      ],
      "options": {
        "cwd": "${workspaceFolder}/dashboard"
      },
      "problemMatcher": [],
